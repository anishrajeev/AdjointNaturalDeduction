type nat[m] = [m](+{'zero : [m](1), 'succ : nat[m]})

proc ack_two_two$0 (s$55 : nat[U])  =
    cut s$57 : nat[U] {
        call two$0 s$57 
    }
    cut s$58 : nat[U] {
        call two$0 s$58 
    }
    call ack$0 s$55 s$57 s$58

proc ack$0 (s$31 : nat[U]) (m : nat[U]) (n : nat[U]) =
    read m {
    | 'zero(n$2) => read n$2 {
                    | () => write s$31 'succ(n)
                    }
    | 'succ(n$2) => read n {
                    | 'zero(n$8) => read n$8 {
                                    | () => cut s$45 : nat[U] {
                                                call one$0 s$45 
                                            }
                                            call ack$0 s$31 n$2 s$45
                                    }
                    | 'succ(n$8) => cut s$51 : nat[U] {
                                        call ack$0 s$51 m n$8
                                    }
                                    call ack$0 s$31 n$2 s$51
                    }
    }

proc add$0 (s$19 : nat[U]) (a : nat[U]) (b : nat[U]) =
    read b {
    | 'zero(n$14) => read n$14 {
                     | () => id s$19 a
                     }
    | 'succ(n$14) => cut s$27 : nat[U] {
                         call add$0 s$27 a n$14
                     }
                     call succ$0 s$19 s$27
    }

proc three$0 (s$15 : nat[U])  =
    cut s$17 : nat[U] {
        call two$0 s$17 
    }
    call succ$0 s$15 s$17

proc two$0 (s$11 : nat[U])  =
    cut s$13 : nat[U] {
        call one$0 s$13 
    }
    call succ$0 s$11 s$13

proc one$1 (s$4 : nat[S])  =
    cut s$9 : nat[S] {
        cut s$10 : [S](1) {
            write s$10 ()
        }
        write s$9 'zero(s$10)
    }
    call succ$1 s$4 s$9

proc one$0 (s$4 : nat[U])  =
    cut s$6 : nat[U] {
        cut s$7 : [U](1) {
            write s$7 ()
        }
        write s$6 'zero(s$7)
    }
    call succ$0 s$4 s$6

proc succ$1 (s$1 : nat[S]) (n : nat[S]) =
    write s$1 'succ(n)

proc succ$0 (s$1 : nat[U]) (n : nat[U]) =
    write s$1 'succ(n)

