type nat[k] = +{'zero : 1, 'succ : nat[k]}
type list[m k] = +{'nil : 1, 'cons : <nat[k]> * list[m k]}
type bool[m] = +{'true : [m]1, 'false : [m]1}

(*linear search*)

defn equal_nat (x1 : nat) (x2 : nat) : bool =
match x1, x2 with
| ('zero(), 'zero()) => 'true()
| ('succ n, 'succ m) => equal_nat n m
| ('succ x, 'zero()) => 'false()
| ('zero(), 'succ x) => 'false()
end
inst equal_nat (x1 : nat[A]) (x2 : nat[A]) : bool[A]

defn search (f : ^(nat -> bool)) (l : list) : bool =
   match l with
   | 'nil() => 'false()
   | 'cons(<hd>, tl) =>
      match f.force hd with
      | 'true() => 'true()
      | 'false() => search f tl
      end
   end
inst search (f : [U]^(nat[A] -> bool[A])) (l : list [A A]) : bool[L]

defn one : nat[A] = 'succ('zero())
defn two : nat[A] = 'succ one
defn three : nat[A] = 'succ two
defn four : nat[A] = 'succ three

defn l1 : list[A A] = 'cons(<one>, 'nil())
defn l2 : list[A A] = 'cons(<two>, l1)
defn l3 : list[A A] = 'cons(<three>, l2)
defn l4 : list[A A] = 'cons(<four>, l3)
defn fl3 : list[A A] = 'cons(<three>, l1)
defn fl4 : list[A A] = 'cons(<four>, fl3) 

defn f2 : nat[A] -> bool[A] = fun x => equal_nat x two
defn f2s : [U]^(nat[A] -> bool[A]) = susp (f2)

defn t : bool[L] = search f2s l4
defn f : bool[L] = search f2s fl4