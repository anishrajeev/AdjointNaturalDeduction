type bool[m] = +{'true : 1, 'false : 1}
type char[m] = +{'b0 : 1, 'b1 : 1}
type str[m] = +{'nil : 1, 'cons : char[m] * str[m]}
type automaton[m] = &{'accepts : bool[m], 'step : char[m] -> automaton[m]}

defn run_automaton : automaton[L] -> str[L] -> bool[L] = fun a => fun s => match s with
| 'nil () => a .'accepts
| 'cons (c, s) => run_automaton (a .'step c) s
end