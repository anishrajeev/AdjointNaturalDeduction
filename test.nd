type nat[m] = +{'zero : 1, 'succ : nat[m]}
type bool[m] = +{'true : 1, 'false : 1}

defn succ (n : nat) : nat = 'succ n

defn nat_eq (l : nat) (r : nat) : bool =
    match (l, r) with
    | ('zero (), 'zero ()) => 'true ()
    | ('zero (), 'succ r1) => 'false ()
    | ('succ l1, 'zero ()) => 'true ()
    | ('succ l1, 'succ r1) => nat_eq l1 r1
    end
inst nat_eq (l : nat[A]) (r : nat[A]) : bool[A]

defn add (a : nat) (b : nat) : nat =
match b with
| 'zero () => a
| 'succ b1 => succ (add a b1)
end

type stream_result[s e] = <nat[e]> * (+{ 'none : 1, 'some : nat_stream[s e] })
type nat_stream[s e] = &{ 'next : stream_result[s e] }

% inclusive
defn range (lo : <nat>) (hi : <nat>) : nat_stream = match (lo, hi) with
| (<slo>, <shi>) => cond_range (nat_eq slo shi) lo hi
end

% bc of edstem #79
defn cond_range (cond : bool) (lo : <nat>) (hi : <nat>) : nat_stream =
match cond with
| 'true () => (record
               | 'next => (lo, 'none ())
               end)
| 'false () => (record
                | 'next => (match lo with
                            | <slo> => (lo, 'some (range <(succ slo)> hi))
                            end)
                end)
end