type nat[m] = +{'succ : nat[m], 'zero : 1}

type nlist[m k] = +{'cons : <nat[k]> * nlist[m k], 'nil : 1}

defn addl (l : nlist[L L]) : nlist[L L] =
  match l with
  | 'nil () => 'nil ()
  | 'cons (<x>, xs) => 'cons(<'succ x>, addl xs)
  end

defn mylist : nlist[L L] = 'cons (<'zero ()>, 'cons (<'succ 'zero ()>, 'cons (<'succ 'succ 'zero ()>, 'nil ())))
defn mylist2 : nlist[L L] = addl mylist