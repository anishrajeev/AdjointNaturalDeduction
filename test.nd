type bool[m] = +{'true : 1, 'false : 1}
type list[m k] = +{'nil : 1, 'cons: <[k]int32> * list[m k]}
type filter[m k l] = &{'filter: <[k]int32>, 'extract: <list[l k]>}

defn succ (x:[U]int32) : [U]int32 = x + 1
defn add (x:[U]int32) (y:[U]int32) : [U]int32 =  x + y
defn pred (x:[U]int32) : [U]int32 =  x - 1
defn sub (x:[U]int32) (y:[U]int32) : [U]int32 =  x - y

defn mul (x:[U]int32) (y:[U]int32) : [U]int32 =  x * y

defn square (x:[U]int32) : [U]int32 = mul x x

defn equal (x:[U]int32) (y:[U]int32) : bool = x = y

defn leq (x:[U]int32) (y:[U]int32) : bool =
match (x = 0, y = 0) with
| ('true (), 'true()) => 'true()
| ('false (), 'true()) => 'false()
| ('false (), 'false ()) => leq (x - 1) (y - 1)
| ('true (), 'false()) => 'true()
end

defn lt (x:[U]int32) (y:[U]int32) : bool =
lt_helper x y (leq x y)

defn lt_helper (x:[U]int32) (y:[U]int32) (leq : bool[U]) : bool =
match (leq, x = y) with
| ('true (), 'false ()) => 'true ()
| ('true (), 'true ()) => 'false ()
| ('false (), 'true ()) => 'false ()
| ('false (), 'false ()) => 'false ()
end