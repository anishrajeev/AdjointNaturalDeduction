type nat[m] = +{ 'z: 1, 's: nat[m] }
type stream[m] = &{ 'next: nat[m] * stream[m] }
type list[m] = +{ 'cons: nat[m] * list[m], 'nil: 1 }

defn add_nat (x : nat) (y : nat) : nat =
    match x, y with
        | 'z (), y => y
        | 's x, y => 's (add_nat x y)
    end

defn fib_stream_helper (a : nat) (b : nat) : stream =
    record
    | 'next =>
        match (b, b) with
        | b1, b2 => (add_nat a b1, fib_stream_helper b2 (add_nat a b1))
        end
    end
