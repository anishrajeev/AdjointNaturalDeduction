type bool[m] = [m](+{'true : [m](1), 'false : [m](1)})

type char[m] = [m](+{'b0 : [m](1), 'b1 : [m](1)})

type str[m] = [m](+{'nil : [m](1), 'cons : [m]((char[m] * str[m]))})

type automaton[m] = [m](&{'accepts : bool[m], 'step : [m]((char[m] -> automaton[m]))})

proc run_automaton$0 (s$1 : [L]((automaton[L] -> [L]((str[L] -> bool[L])))))  =
    write s$1 {
    | (a, s$2) => call run_automaton$0_1 s$2 a
    }

proc run_automaton$0_1 (d$0 : [L]((str[L] -> bool[L]))) (a : automaton[L]) =
    write d$0 {
    | (s, s$3) => read s {
                  | 'nil(n$2) => read n$2 {
                                 | () => read a 'accepts(s$3)

                                 }
                  | 'cons(n$2) => read n$2 {
                                  | (n$9, n$10) => cut s$19 : [L]((automaton[L] -> [L]((str[L] -> bool[L])))) {
                                                       call run_automaton$0 s$19 
                                                   }
                                                   cut s$20 : automaton[L] {
                                                       cut s$24 : [L]((char[L] -> automaton[L])) {
                                                           read a 'step(s$24)

                                                       }
                                                       read s$24 (n$9, s$20)

                                                   }
                                                   cut s$21 : [L]((str[L] -> bool[L])) {
                                                       read s$19 (s$20, s$21)

                                                   }
                                                   read s$21 (n$10, s$3)

                                  }
                  }
    }

