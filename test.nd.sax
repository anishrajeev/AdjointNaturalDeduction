type nat[m] = [m](+{'succ : nat[m], 'zero : [m](1)})

type nlist[m k] = [m](+{'cons : [m](([m](<nat[k]>) * nlist[m k])), 'nil : [m](1)})

proc mylist2$0 (s$45 : nlist[L L])  =
    cut s$47 : nlist[L L] {
        call mylist$0 s$47 
    }
    call addl$0 s$45 s$47

proc mylist$0 (s$25 : nlist[L L])  =
    cut s$26 : [L](([L](<nat[L]>) * nlist[L L])) {
        cut s$27 : [L](<nat[L]>) {
            cut s$43 : nat[L] {
                cut s$44 : [L](1) {
                    write s$44 ()
                }
                write s$43 'zero(s$44)
            }
            write s$27 <s$43>
        }
        cut s$28 : nlist[L L] {
            cut s$29 : [L](([L](<nat[L]>) * nlist[L L])) {
                cut s$30 : [L](<nat[L]>) {
                    cut s$40 : nat[L] {
                        cut s$41 : nat[L] {
                            cut s$42 : [L](1) {
                                write s$42 ()
                            }
                            write s$41 'zero(s$42)
                        }
                        write s$40 'succ(s$41)
                    }
                    write s$30 <s$40>
                }
                cut s$31 : nlist[L L] {
                    cut s$32 : [L](([L](<nat[L]>) * nlist[L L])) {
                        cut s$33 : [L](<nat[L]>) {
                            cut s$36 : nat[L] {
                                cut s$37 : nat[L] {
                                    cut s$38 : nat[L] {
                                        cut s$39 : [L](1) {
                                            write s$39 ()
                                        }
                                        write s$38 'zero(s$39)
                                    }
                                    write s$37 'succ(s$38)
                                }
                                write s$36 'succ(s$37)
                            }
                            write s$33 <s$36>
                        }
                        cut s$34 : nlist[L L] {
                            cut s$35 : [L](1) {
                                write s$35 ()
                            }
                            write s$34 'nil(s$35)
                        }
                        write s$32 (s$33, s$34)
                    }
                    write s$31 'cons(s$32)
                }
                write s$29 (s$30, s$31)
            }
            write s$28 'cons(s$29)
        }
        write s$26 (s$27, s$28)
    }
    write s$25 'cons(s$26)

proc addl$0 (s$1 : nlist[L L]) (l : nlist[L L]) =
    read l {
    | 'cons(n$2) => read n$2 {
                    | (n$9, n$10) => read n$9 {
                                     | <n$18> => cut s$15 : [L](([L](<nat[L]>) * nlist[L L])) {
                                                     cut s$16 : [L](<nat[L]>) {
                                                         cut s$20 : nat[L] {
                                                             write s$20 'succ(n$18)
                                                         }
                                                         write s$16 <s$20>
                                                     }
                                                     cut s$17 : nlist[L L] {
                                                         call addl$0 s$17 n$10
                                                     }
                                                     write s$15 (s$16, s$17)
                                                 }
                                                 write s$1 'cons(s$15)
                                     }
                    }
    | 'nil(n$2) => read n$2 {
                   | () => cut s$24 : [L](1) {
                               write s$24 ()
                           }
                           write s$1 'nil(s$24)
                   }
    }

