type nat[m] = [m](+{'z : [m](1), 's : nat[m]})

type stream[m] = [m](&{'next : [m]((nat[m] * stream[m]))})

type list[m] = [m](+{'cons : [m]((nat[m] * list[m])), 'nil : [m](1)})

proc fib_stream_helper$0 (s$24 : stream[U]) (a : nat[U]) (b : nat[U]) =
    call fib_stream_helper$0_1 s$24 b a

proc fib_stream_helper$0_1 (d$0 : stream[U]) (b : nat[U]) (a : nat[U]) =
    write d$0 {
    | 'next(s$25) => cut s$26 : [U]((nat[U] * nat[U])) {
                         write s$26 (b, b)
                     }
                     read s$26 {
                     | (n$2, n$3) => cut s$34 : nat[U] {
                                         call add_nat$0 s$34 a n$2
                                     }
                                     cut s$35 : stream[U] {
                                         cut s$38 : nat[U] {
                                             call add_nat$0 s$38 a n$2
                                         }
                                         call fib_stream_helper$0 s$35 n$3 s$38
                                     }
                                     write s$25 (s$34, s$35)
                     }
    }

proc add_nat$0 (s$1 : nat[U]) (x : nat[U]) (y : nat[U]) =
    cut s$2 : [U]((nat[U] * nat[U])) {
        write s$2 (x, y)
    }
    read s$2 {
    | (n$11, n$12) => read n$11 {
                      | 'z(n$18) => read n$18 {
                                    | () => id s$1 n$12
                                    }
                      | 's(n$18) => cut s$20 : nat[U] {
                                        call add_nat$0 s$20 n$18 n$12
                                    }
                                    write s$1 's(s$20)
                      }
    }

