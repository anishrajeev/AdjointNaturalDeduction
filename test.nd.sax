type tester[m] = [m](+{'nil : [m](1)})

type modelboolean[m] = [m](+{'false : [m](1), 'true : [m](1), 'maybe : [m](1)})

type boolean[m] = [m](+{'false : [m](1), 'true : [m](1)})

proc five$0 (s$1 : [A](int32))  =
    set s$1 5

proc three$0 (s$2 : [A](int32))  =
    set s$2 3

proc equal$0 (s$3 : [A](int32)) (x : [A](int32)) (y : [A](int32)) =
    cut s$4 : [A](+{'true : [A](1), 'false : [A](1)}) {
        cut s$5 : [A](int32) {
            id s$5 x
        }
        cut s$6 : [A](int32) {
            id s$6 y
        }
        eq s$4 x  y
    }
    cut n$1 : [A](+{'true : [A](1), 'false : [A](1)}) {
        id n$1 s$4
    }
    cut s$7 : [A](+{'true : [A](1), 'false : [A](1)}) {
        id s$7 n$1
    }
    read s$7 {
    | 'true(n$2) => cut s$8 : [A](1) {
                        id s$8 n$2
                    }
                    cut n$3 : [A](1) {
                        id n$3 s$8
                    }
                    cut s$9 : [A](1) {
                        id s$9 n$3
                    }
                    read s$9 {
                    | () => set s$3 1
                    }
    | 'false(n$2) => cut s$10 : [A](1) {
                         id s$10 n$2
                     }
                     cut n$4 : [A](1) {
                         id n$4 s$10
                     }
                     cut s$11 : [A](1) {
                         id s$11 n$4
                     }
                     read s$11 {
                     | () => set s$3 0
                     }
    }

proc one$0 (s$12 : [A](int32))  =
    cut s$14 : [A](int32) {
        cut s$16 : [A](int32) {
            call five$0 s$16 
        }
        id s$14 s$16
    }
    cut s$15 : [A](int32) {
        set s$15 5
    }
    cut s$13 : [A](int32) {
        call equal$0 s$13 s$14 s$15
    }
    id s$12 s$13

