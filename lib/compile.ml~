type label = [%import: Ast.label]
type tpname = [%import: Ast.tpname]
type modename = [%import: Ast.modename]
type mode = [%import: Ast.mode]
type tp = [%import: Ast.tp]
type varname = [%import: Ast.varname]
type expname = [%import: Ast.expname]
type pat = [%import: Ast.pat]
type exp = [%import: Ast.exp]
and atom = [%import: Ast.atom]
type parm = [%import: Ast.parm]
type defn = [%import: Ast.defn]
type env =  [%import: Ast.env]

exception UnnestError of string

type context = parm list

type tpdefn = tpname * (mode list) * tp
type expdefn = expname * context * tp * exp
type patseq = (pat list) * exp

let tp_defns : env ->  (tpdefn list) =
  List.fold_left
    (fun ac -> fun d ->
       match d with
       | TypeDefn (tn, ml, t) -> (tn, ml, t)::ac
       | _ -> ac) []

let exp_defns : env -> (expdefn list) =
  List.fold_left
    (fun ac -> fun d ->
       match d with
       | ExpDefn (en, pl, t, e) -> (en, pl, t, e)::ac
       | _ -> ac) []

let inst_defns (program : env) : instdefn list =
  List.fold_right
    (fun d -> fun ac ->
       match d with
       | InstDefn (en, pl, t) ->
         let sheared = List.map (fun (_, y) -> y) pl in
         (en, sheared, t)::ac
       | ExpDefn (en, pl, t, _) ->
         let sheared = List.map (fun (_, y) -> y) pl in
         (en, sheared, t)::ac
       | _ -> ac) program []

let rec print_context (input : context) : string =
  (match input with
  | [] -> "EMPTYCONTEXT\n"
  | (vn, t)::input -> "(" ^ vn ^ ": " ^ (Ast.Print.pp_tp t) ^ ") " ^ (print_context input))

let counter = ref 0
let increment () = counter := !counter + 1
let get_count () = !counter

let next () =
  increment();
  (string_of_int (get_count()))

let rec contains (c : context) (v : string) : tp =
  match c with
  | ((v', t)::c) -> if v = v' then t else contains c v
  | [] -> raise (CompileError ("Can't find " ^ v ^ " in the given context"))

let rec translate_tp (ndtp : tp) : S.tp =
  match ndtp with
  | Times (t1, t2) -> S.Times (translate_tp t1, translate_tp t2)
  | One -> S.One
  | Plus ltl ->
    S.Plus
      (List.map (fun (l, t) -> (l, translate_tp t)) ltl)
  | Arrow (t1, t2) -> S.Arrow (translate_tp t1, translate_tp t2)
  | With ltl -> S.With (List.map (fun (l, t) -> (l, translate_tp t)) ltl)
  | TpName name -> S.TpName name

let rec find_defn (defns : defn_type list) (name : defnname) : defn_type =
  match defns with
  | (dn, tp, pl)::defns -> if dn = name then (dn, tp, pl) else (find_defn defns name)
  | [] -> raise (CompileError ("Can't find definition named " ^ name))

let rec synthesize (defns : defn_type list) (gamma : context) (types : context) (e : exp) : tp =
  match e with
  | Var vn ->
    (try  contains gamma vn
     with
     | _ -> let (_, t, _) = find_defn defns vn in t)
  | Pair (e1, e2) -> Times ((synthesize defns gamma types e1), (synthesize defns gamma types e2))
  | Unit -> One
  | Inj (_, _) -> raise (CompileError "Can't synthesize a sum")
  | MatchWith (_, _) -> raise (CompileError "Can't synthesize a match")
  | Call (vn, spine) ->
    let rec spine_crusher (spine : atom list) (t : tp) =
      let t = (match t with | TpName name -> contains types name | _ -> t) in
      match (spine, t) with
      | ([], _) -> t
      | ((Exp e)::spine, Arrow (t1, t2)) -> spine_crusher spine t2
      | ((Dot l)::spine, With ltl) -> spine_crusher spine (contains ltl l)
      | _ -> raise (CompileError "Spine crushing error") in
    (try
       let t = contains gamma vn in
       spine_crusher spine t
     with
     | _ ->
       let (_, t, pl) = find_defn defns vn in
       let rec remove_top_n (spine : atom list) (n : int) =
         match (spine, n) with
         | (s, 0) -> s
         | ([], _) -> raise (CompileError "Not enough to remove")
         | (_::spine, n) -> remove_top_n spine (n-1) in
       let leftover = remove_top_n spine (List.length pl) in
       spine_crusher leftover t)
  | Fun _ -> raise (CompileError "Can't synthesize an anon function")
  | Record _ -> raise (CompileError "Can't synthesize a record")

let rec translate_exp (types : context) (defns : defn_type list) (gamma : context) (dest : string) (desttp : tp) (e : exp) : S.cmd =
  match e with
  | Var v ->
    (try
       let _ = contains gamma v in
       S.Id (dest, v)
    with
    | _ ->
      let _ = find_defn defns v in
      translate_exp types defns gamma dest desttp (Call (v, [])))
  | Pair (e1, e2) ->
    let desttp = (match desttp with | TpName name -> contains types name | _ -> desttp) in
    let (t1, t2) = (match desttp with | Times (t1, t2) -> (t1, t2) | _ -> raise (CompileError "Type error")) in
    let firstfresh = "s$"^(next ()) in
    let secondfresh = "s$"^(next ()) in
    S.Cut (firstfresh, translate_tp t1,
           (translate_exp types defns gamma firstfresh t1 e1),
           (S.Cut
              (secondfresh, translate_tp t2,
               (translate_exp types defns gamma secondfresh t2 e2),
               S.Write (dest, Small (PairPat (firstfresh, secondfresh))))))
  | Unit -> S.Write (dest, Small UnitPat)
  | Inj (lab, e) ->
    let desttp = (match desttp with | TpName name -> contains types name | _ -> desttp) in
    let ltl = (match desttp with | Plus ltl -> ltl | _ -> raise (CompileError "Typing Error1")) in
    let al = contains ltl lab in
    let als = translate_tp al in
    let fresh = "s$"^(next ()) in
    S.Cut (fresh, als, translate_exp types defns gamma fresh al e, S.Write (dest, Small (InjPat (lab, fresh))))
  | MatchWith (e, pel) ->
    let synth = synthesize defns gamma types e in
    let synth = (match synth with | TpName name -> contains types name | _ -> synth) in
    (match synth with
     | Times (t1, t2) ->
       (match pel with
        | (PairPat (VarPat v1, VarPat v2), branch)::[] ->
          let fresh = "s$"^(next ()) in
          let st1 = translate_tp t1 in
          let st2 = translate_tp t2 in
          let etrans = translate_exp types defns gamma fresh (Times (t1, t2)) e in
          let branchtrans = translate_exp types defns ((v1, t1)::(v2, t2)::gamma) dest desttp branch in
          S.Cut (fresh, S.Times (st1, st2), etrans, S.Read (fresh, Branches [S.PairPat (v1, v2), branchtrans]))
        | (VarPat v, branch)::[] ->
          let fresh = "s$"^(next ()) in
          let etrans = translate_exp types defns gamma fresh (Times (t1, t2)) e in
          let st1 = translate_tp t1 in
          let st2 = translate_tp t2 in
          let branchtrans = translate_exp types defns ((v, Times (t1, t2))::gamma) dest desttp branch in
          S.Cut (fresh, S.Times (st1, st2), etrans,
                 S.Cut(v, S.Times (st1, st2), S.Id (v, fresh), branchtrans))
        | _ -> raise (CompileError "You have tried deconstructing a product type with not a proper branch!"))
     | One -> 
       (match pel with
        | (UnitPat, ep)::[] ->
          let fresh = "s$"^(next ()) in
          S.Cut(fresh, One, translate_exp types defns gamma fresh One e,
                S.Read (fresh, Branches [(S.UnitPat, translate_exp types defns gamma dest desttp ep)]))
        | (VarPat v, branch)::[] ->
          let fresh = "s$"^(next ()) in
          let etrans = translate_exp types defns gamma fresh One e in
          let branchtrans = translate_exp types defns ((v, One)::gamma) dest desttp branch in
          S.Cut (fresh, One, etrans,
                 S.Cut(v, One, S.Id (v, fresh), branchtrans))
        | _ -> raise (CompileError "You tried having more patterns than just the unit when deconstructing unit type!"))
       
     | Plus ltl ->
       let sltl = List.map (fun (l, t) -> (l, translate_tp t)) ltl in
       let fresh = "s$"^(next ()) in
       let etrans = translate_exp types defns gamma fresh (Plus ltl) e in
       (match pel with
        | (VarPat v, branch)::[] ->
          let branchtrans = translate_exp types defns ((v, Plus ltl)::gamma) dest desttp branch in
          S.Cut (fresh, S.Plus sltl, etrans,
                 S.Cut(v, S.Plus sltl, S.Id (v, fresh), branchtrans))
        | _ ->
          let branchtranses =
            List.map
              (fun (patt, branche) ->
                 match (patt, branche) with
                 | (InjPat (l, VarPat v), branche) ->
                   let al = contains ltl l in
                   let branchtrans = translate_exp types defns ((v, al)::gamma) dest desttp branche in
                   (S.InjPat (l, v), branchtrans)
                 | (_, _) ->
                   raise (CompileError "Tried deconstructing a sum type using non labels!")) pel in
          S.Cut (fresh, S.Plus sltl, etrans, S.Read (fresh, Branches branchtranses)))
     | Arrow (t1, t2) ->
       (match pel with
        | (VarPat v, branch)::[] ->
          S.Cut (v, translate_tp synth, translate_exp types defns gamma v synth e,
                 translate_exp types defns ((v, synth)::gamma) dest desttp branch)
        | _ -> raise (CompileError "Can't match a func type against anything but a var"))
     | With ltl ->
       (match pel with
        | (VarPat v, branch)::[] ->
          S.Cut (v, translate_tp synth, translate_exp types defns gamma v synth e,
                 translate_exp types defns ((v, synth)::gamma) dest desttp branch)
        | _ -> raise (CompileError "Can't match a record type against anything but a var"))
     | _ -> raise (CompileError "Typing Error2"))
  | Call (vn, spine) ->
    let rec spine_crusher (spine : atom list) (t : tp) (source : varname) =
      let t = (match t with | TpName name -> contains types name | _ -> t) in
      (match (spine, t) with
       | ([], _) -> S.Id (dest, source)
       | ((Exp e)::spine, Arrow (t1, t2)) ->
         let fresh1 = "s$"^(next()) in
         let fresh2 = "s$"^(next()) in
         S.Cut (fresh1, translate_tp t1, translate_exp types defns gamma fresh1 t1 e,
                S.Cut (fresh2, translate_tp t2, S.Read (source, Small (PairPat (fresh1, fresh2))), spine_crusher spine t2 fresh2))
       | ((Dot l)::spine, With ltl) ->
         let t = contains ltl l in
         let fresh = "s$"^(next ()) in
         S.Cut (fresh, translate_tp t, S.Read (source, Small (InjPat (l, fresh))), spine_crusher spine t fresh)
       | _ -> raise (CompileError "Typing Error3"))
    in
    (try
       let t = contains gamma vn in
       spine_crusher spine t vn
    with
    | _ ->
      let (_, t, pl) = find_defn defns vn in
      let rec get_top_n (a : atom list) (n : int) =
        match (a, n) with
        | (_, 0) -> []
        | ((Exp e)::xs, n) -> e::(get_top_n xs (n-1))
        | _ -> raise (CompileError "Couldn't get that many expression elements off of atom list")
      in
      let rec remove_top_n (a : atom list) (n : int) =
        match (a, n) with
        | (xs, 0) -> xs
        | (_::xs, n) -> remove_top_n xs (n-1)
        | _ -> raise (CompileError "Couldn't get that many elements off of atom list") in
      let fresh = "s$"^(next ()) in
      let (used, leftover) = (get_top_n spine (List.length pl), remove_top_n spine (List.length pl)) in
      let suffix = spine_crusher leftover t fresh in
      let rec finisher (used : exp list) (pl : parm list) (acc : string list) =
        match (used, pl) with
        | ([], []) -> S.Cut (fresh, translate_tp t, S.Call (vn, fresh, List.rev acc), suffix)
        | (e::used, (_, t)::pl) ->
          let freshn = "s$"^(next ()) in
          S.Cut (freshn, translate_tp t, translate_exp types defns gamma freshn t e, finisher used pl (freshn::acc))
        | _ -> raise (CompileError "SRSERROR")
      in
      finisher used pl []
   )
  | Fun (vn, e) ->
    let desttp = (match desttp with | TpName name -> contains types name | _ -> desttp) in
    (match desttp with
    | Arrow (t1, t2) ->
      let fresh =  "s$"^(next ()) in
      S.Write (dest, (S.Branches [S.PairPat (vn, fresh), translate_exp types defns ((vn, t1)::gamma) fresh t2 e]))
    | _ -> raise (CompileError "Typing Error4"))
  | Record lel ->
    let desttp = (match desttp with | TpName name -> contains types name | _ -> desttp) in
    (match desttp with
     | With ltl ->
       let branches =
         List.filter_map
           (fun (lab, e) ->
              let fresh = "s$"^(next ()) in
              try
                let tp = contains ltl lab in
                Some (S.InjPat (lab, fresh), translate_exp types defns gamma fresh tp e)
              with
              | _ -> None
           ) lel in
       S.Write (dest, S.Branches branches)
     | _ -> raise (CompileError "Typing Error5"))
    
    
let translate_defn (types : context) (defns : defn_type list) (d : defn) : S.defn =
  match d with
  | TypeDefn (tn, t) -> S.TypeDefn (tn, translate_tp t)
  | ExpDefn (en, pl, t, e) ->
    let fresh = "s$"^(next ()) in
    let command = translate_exp types defns pl fresh t e in
    let spl = List.map (fun (v, t) -> (v, translate_tp t)) pl in
    ProcDefn (en, (fresh, translate_tp t), spl, command)

let translate_program (program : env) : S.env =
  let types = type_list program in
  let defns = defn_list program in
  List.map (translate_defn types defns) program
