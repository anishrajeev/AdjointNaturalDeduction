proc bfrom$0 (s$180 : broader_suspense[L L]) (s : normal_suspended[L L]) =
    cut s$181 : [L]((nat[L] * [L]((nat[L] -> nat[L])))) {
        cut s$182 : nat[L] {
            cut s$196 : [L](1) {
                write s$196 ()
            }
            write s$182 'zero(s$196)
        }
        cut s$183 : [L]((nat[L] -> nat[L])) {
            write s$183 {
            | (n, s$184) => read n {
                            | 'zero(n$7) => read n$7 {
                                            | () => read s {
                                                    | <n$11> => read n$11 <s$184>

                                                    }
                                            }
                            | 'succ(n$7) => call die2$0 s$184 n$7 s
                            }
            }
        }
        write s$181 (s$182, s$183)
    }
    write s$180 <s$181>

proc test$0 (s$197 : nat[L])  =
    cut s$200 : suspense[L] {
        cut s$202 : also_suspended[L] {
            cut s$204 : suspense[L] {
                cut s$205 : nat[L] {
                    cut s$210 : [L](1) {
                        write s$210 ()
                    }
                    write s$205 'zero(s$210)
                }
                cut s$206 : [L]((nat[L] -> nat[L])) {
                    write s$206 {
                    | (z, s$207) => cut s$208 : nat[L] {
                                        write s$208 'succ(z)
                                    }
                                    write s$207 'succ(s$208)
                    }
                }
                write s$204 (s$205, s$206)
            }
            call to2$0 s$202 s$204
        }
        call from2$0 s$200 s$202
    }
    cut s$198 : also_suspended[L] {
        call to$0 s$198 s$200
    }
    read s$198 <s$197>


proc test2$0 (s$211 : [L](<[L](^(nat[L]))>))  =
    cut s$213 : broader_suspense[L L] {
        cut s$215 : normal_suspended[L L] {
            cut s$217 : broader_suspense[L L] {
                cut s$218 : [L]((nat[L] * [L]((nat[L] -> nat[L])))) {
                    cut s$219 : nat[L] {
                        cut s$225 : [L](1) {
                            write s$225 ()
                        }
                        write s$219 'zero(s$225)
                    }
                    cut s$220 : [L]((nat[L] -> nat[L])) {
                        write s$220 {
                        | (z, s$221) => cut s$222 : nat[L] {
                                            cut s$223 : nat[L] {
                                                write s$223 'succ(z)
                                            }
                                            write s$222 'succ(s$223)
                                        }
                                        write s$221 'succ(s$222)
                        }
                    }
                    write s$218 (s$219, s$220)
                }
                write s$217 <s$218>
            }
            call bto$1 s$215 s$217
        }
        call bfrom$0 s$213 s$215
    }
    call bto$1 s$211 s$213

