type nat[m] = [m](+{'zero : [m](1), 'succ : nat[m]})

type bool[m] = [m](+{'true : [m](1), 'false : [m](1)})

proc succ$0 (s$1 : nat[U]) (n : nat[U]) =
    write s$1 'succ(n)

proc nat_eq$0 (s$3 : bool[U]) (l : nat[U]) (r : nat[U]) =
    cut s$4 : [U]((nat[U] * nat[U])) {
        write s$4 (l, r)
    }
    read s$4 {
    | (n$38, n$39) => read n$38 {
                      | 'zero(n$47) => read n$47 {
                                       | () => read n$39 {
                                               | 'zero(n$54) => read n$54 {
                                                                | () => cut s$20 : [U](1) {
                                                                            write s$20 ()
                                                                        }
                                                                        write s$3 'true(s$20)
                                                                }
                                               | 'succ(n$54) => cut s$25 : [U](1) {
                                                                    write s$25 ()
                                                                }
                                                                write s$3 'false(s$25)
                                               }
                                       }
                      | 'succ(n$47) => read n$39 {
                                       | 'zero(n$69) => read n$69 {
                                                        | () => cut s$36 : [U](1) {
                                                                    write s$36 ()
                                                                }
                                                                write s$3 'true(s$36)
                                                        }
                                       | 'succ(n$69) => call nat_eq$0 s$3 n$47 n$69
                                       }
                      }
    }

proc nat_eq$1 (s$3 : bool[A]) (l : nat[A]) (r : nat[A]) =
    cut s$44 : [A]((nat[A] * nat[A])) {
        write s$44 (l, r)
    }
    read s$44 {
    | (n$38, n$39) => read n$38 {
                      | 'zero(n$47) => read n$47 {
                                       | () => read n$39 {
                                               | 'zero(n$54) => read n$54 {
                                                                | () => cut s$60 : [A](1) {
                                                                            write s$60 ()
                                                                        }
                                                                        write s$3 'true(s$60)
                                                                }
                                               | 'succ(n$54) => cut s$65 : [A](1) {
                                                                    write s$65 ()
                                                                }
                                                                write s$3 'false(s$65)
                                               }
                                       }
                      | 'succ(n$47) => read n$39 {
                                       | 'zero(n$69) => read n$69 {
                                                        | () => cut s$76 : [A](1) {
                                                                    write s$76 ()
                                                                }
                                                                write s$3 'true(s$76)
                                                        }
                                       | 'succ(n$69) => call nat_eq$1 s$3 n$47 n$69
                                       }
                      }
    }

proc add$0 (s$84 : nat[U]) (a : nat[U]) (b : nat[U]) =
    read b {
    | 'zero(n$32) => read n$32 {
                     | () => id s$84 a
                     }
    | 'succ(n$32) => cut s$92 : nat[U] {
                         call add$0 s$92 a n$32
                     }
                     call succ$0 s$84 s$92
    }

type stream_result[s e] = [s](([s](<nat[e]>) * [s](+{'none : [s](1), 'some : nat_stream[s e]})))

type nat_stream[s e] = [s](&{'next : stream_result[s e]})

proc range$0 (s$96 : nat_stream[U U]) (lo : [U](<nat[U]>)) (hi : [U](<nat[U]>)) =
    cut s$97 : [U](([U](<nat[U]>) * [U](<nat[U]>))) {
        write s$97 (lo, hi)
    }
    read s$97 {
    | (n$11, n$12) => read n$11 {
                      | <n$18> => read n$12 {
                                  | <n$25> => cut s$112 : bool[U] {
                                                  call nat_eq$0 s$112 n$18 n$25
                                              }
                                              call cond_range$0 s$96 s$112 lo hi
                                  }
                      }
    }

proc cond_range$0 (s$118 : nat_stream[U U]) (cond : bool[U]) (lo : [U](<nat[U]>)) (hi : [U](<nat[U]>)) =
    read cond {
    | 'true(n$2) => read n$2 {
                    | () => write s$118 {
                            | 'next(s$123) => cut s$125 : [U](+{'none : [U](1), 'some : nat_stream[U U]}) {
                                                  cut s$126 : [U](1) {
                                                      write s$126 ()
                                                  }
                                                  write s$125 'none(s$126)
                                              }
                                              write s$123 (lo, s$125)
                            }
                    }
    | 'false(n$2) => read n$2 {
                     | () => write s$118 {
                             | 'next(s$129) => read lo {
                                               | <n$6> => cut s$134 : [U](+{'none : [U](1), 'some : nat_stream[U U]}) {
                                                              cut s$135 : nat_stream[U U] {
                                                                  cut s$137 : [U](<nat[U]>) {
                                                                      cut s$139 : nat[U] {
                                                                          call succ$0 s$139 n$6
                                                                      }
                                                                      write s$137 <s$139>
                                                                  }
                                                                  call range$0 s$135 s$137 hi
                                                              }
                                                              write s$134 'some(s$135)
                                                          }
                                                          write s$129 (lo, s$134)
                                               }
                             }
                     }
    }

