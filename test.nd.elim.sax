proc succ_nat$0 (s$80 : [U]((nat[U] -> nat[U])))  =
    write s$80 {
    | (x, s$81) => write s$81 'succ(x)
    }

proc succ_nat$1 (s$80 : [U]((nat[U] -> nat[U])))  =
