type nat[m] = [m](+{'zero : [m](1), 'succ : nat[m]})

type suspense[m] = [m]((nat[m] * [m]((nat[m] -> nat[m]))))

type also_suspended[m] = [m](^(nat[m]))

type broader_suspense[m k] = [m](<[k]((nat[k] * [k]((nat[k] -> nat[k]))))>)

type normal_suspended[m k] = [m](<[k](^(nat[k]))>)

