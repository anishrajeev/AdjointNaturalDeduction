                                                             read s$22 (n$18, s$21)

                                                         }
                                                         write s$16 <s$21>
                                                     }
                                                     cut s$17 : natlist[U U] {
                                                         call apply$0 s$17 n$10 f
                                                     }
                                                     write s$15 (s$16, s$17)
                                                 }
