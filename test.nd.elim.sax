    read ns {
    | 'cons(n$2) => read n$2 {
                    | (n$9, n$10) => read n$9 {
                                     | <n$18> => cut s$15 : [U](([U](<nat[U]>) * natlist[U U])) {
                                                     cut s$16 : [U](<nat[U]>) {
