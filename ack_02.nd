type nat[m] = +{'zero : 1, 'succ : nat[m]}

defn succ (n : nat) : nat = 'succ n
inst succ (n : nat[S]) : nat[S]

defn one: nat = succ ('zero ())
inst one: nat[S]

defn two: nat = succ one
defn three: nat = succ two

defn add (a : nat) (b : nat) : nat =
match b with
| 'zero () => a
| 'succ b1 => succ (add a b1)
end

defn ack (m : nat) (n : nat) : nat =
match m with
| 'zero () => 'succ n
| 'succ m1 => (match n with
               | 'zero () => ack m1 one
               | 'succ n1 => ack m1 (ack m n1)
               end)
end
defn ack_two_two : nat = ack two two
