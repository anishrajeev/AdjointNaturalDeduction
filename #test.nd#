type bool[m] = +{'true : 1, 'false : 1}
type list[m k] = +{'nil : 1, 'cons: <[k]int32> * list[m k]}
type filter[m k l] = &{'filter: <[k]int32>, 'extract: <list[l k]>}

defn leq (x:[U]int32) (y:[U]int32) : bool =
match (x = 0, y = 0) with
| ('true (), 'true()) => 'true()
| ('false (), 'true()) => 'false()
| ('false (), 'false ()) => leq (x - 1) (y - 1)
| ('true (), 'false()) => 'true()
end

defn lt (x:[U]int32) (y:[U]int32) : bool[U] =
lt_helper x y (leq x y)

defn lt_helper (x:[U]int32) (y:[U]int32) (leq : bool[U]) : bool[U] =
match (leq, x = y) with
| ('true (), 'false ()) => 'true ()
| ('true (), 'true ()) => 'false ()
| ('false (), 'true ()) => 'false ()
| ('false (), 'false ()) => 'false ()
end
(*true 2 16 *)
defn sieve_list_helper_helper (res:bool[U]) (x:[U]int32) (n:[U]int32) : list[U U] = 
    match res with
    | 'true() => 'cons (<x>,sieve_list_helper (x+1) n)
    | 'false() => 'nil ()
    end
    
defn sieve_list_helper (x:[U]int32) (n:[U]int32) : list[U U] = 
    sieve_list_helper_helper (leq (x * x) n) x n

defn all_list (n:[U]int32) : list[U U] = 
    sieve_list_helper 2 (n * n)

defn four_all : list[U U] = all_list 4